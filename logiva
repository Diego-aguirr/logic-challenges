function solution(numeros) {
  let resultado = [];

  for (let i = 0; i < numeros.length; i++) {
    let existe = false;

    for (let j = 0; j < resultado.length; j++) {
      if (resultado[j] === numeros[i]) {
        existe = true;
      }
    }

    if (!existe) {
      resultado.push(numeros[i]);
    }
  }

  return resultado;
}


